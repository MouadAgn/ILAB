{# templates/patient/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Patient List{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Patient List</h1>

        <button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#patientModal" id="newPatientButton">New Patient</button>

        <table id="table" class="table table-striped">
            <thead>
                <tr>
                    <th>ID Number</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Phone Number</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="patients-list">
                {# Patients will be loaded via JavaScript #}
            </tbody>
        </table>

        {# Modal for New/Edit Patient #}
        <div class="modal fade" id="patientModal" tabindex="-1" aria-labelledby="patientModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="patientModalLabel">Patient Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        {{ form_start(patient_form, {'attr': {'id': 'patientForm'}}) }}
                        {{ form_widget(patient_form) }}
                        {{ form_end(patient_form) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="savePatientButton">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Load patients via AJAX
        fetch('{{ path('patient_table') }}')
            .then(response => response.json())
            .then(data => {
                const patientsList = document.getElementById('patients-list');
                data.forEach(patient => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${patient.id_number}</td>
                        <td>${patient.FirstName}</td>
                        <td>${patient.LastName}</td>
                        <td>${patient.Email}</td>
                        <td>${patient.DateOfBirth}</td>
                        <td>${patient.Gender}</td>
                        <td>${patient.PhoneNumber}</td>
                        <td>
                            <button class="btn btn-info btn-sm edit-patient-button" data-id="${patient.id}">Edit</button>
                            <form action="${patient.url_delete}" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    `;
                    patientsList.appendChild(row);
                });

                // Add event listeners to edit buttons
                document.querySelectorAll('.edit-patient-button').forEach(button => {
                    button.addEventListener('click', function() {
                        const patientId = this.getAttribute('data-id');
                        fetch(`{{ path('patient_show', {'id': 0}) }}`.replace('0', patientId))
                            .then(response => response.json())
                            .then(patient => {
                                // Populate the form with the fetched patient data
                                document.querySelector('#patientForm input[name="patient[id]"]').value = patient.id;
                                document.querySelector('#patientForm input[name="patient[id_number]"]').value = patient.idNumber;
                                document.querySelector('#patientForm input[name="patient[FirstName]"]').value = patient.FirstName;
                                document.querySelector('#patientForm input[name="patient[LastName]"]').value = patient.LastName;
                                document.querySelector('#patientForm input[name="patient[Email]"]').value = patient.Email;
                                
                                const dateOfBirthData = patient.DateOfBirth;
                                if (dateOfBirthData && dateOfBirthData.timestamp) {
                                    const date = new Date(dateOfBirthData.timestamp * 1000); // Convert timestamp to milliseconds
                                    const year = date.getUTCFullYear();
                                    const month = String(date.getUTCMonth() + 1).padStart(2, '0'); // Months are zero-indexed
                                    const day = String(date.getUTCDate()).padStart(2, '0');
                                    const formattedDate = `${year}-${month}-${day}`;
                                    
                                    document.querySelector('#patientForm input[name="patient[DateOfBirth]"]').value = formattedDate;
                                }
                                
                                const gender = patient.Gender;
                                if (gender) {
                                    const genderRadio = document.querySelector(`#patientForm input[name="patient[Gender]"][value="${gender}"]`);
                                    if (genderRadio) {
                                        genderRadio.checked = true;
                                    }
                                }
                                document.querySelector('#patientForm input[name="patient[PhoneNumber]"]').value = patient.PhoneNumber;
                                document.getElementById('savePatientButton').setAttribute('data-id', patientId);
                                new bootstrap.Modal(document.getElementById('patientModal')).show();
                            })
                            .catch(error => console.error('Error fetching patient:', error));
                    });
                });
            })
            .catch(error => console.error('Error fetching patients:', error));

        document.getElementById('newPatientButton').addEventListener('click', function () {
            // Clear the form for a new patient
            document.querySelector('#patientForm').reset();
            document.getElementById('savePatientButton').removeAttribute('data-id');
        });

        document.getElementById('savePatientButton').addEventListener('click', function () {
            var form = document.getElementById('patientForm');
            var formData = new FormData(form);

            var patientId = this.getAttribute('data-id');
            var url = patientId ? '{{ path('patient_edit', {'id': 'PATIENT_ID'}) }}'.replace('PATIENT_ID', patientId) : '{{ path('patient_new') }}';

            // Make an AJAX request
            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.success);
                    location.reload(); // Reload to see the updated list
                } else if (data.error) {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An unexpected error occurred.');
            });
        });
    </script>
{% endblock %}
